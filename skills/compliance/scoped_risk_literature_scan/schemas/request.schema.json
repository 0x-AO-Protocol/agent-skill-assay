{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped risk literature scan request",
  "description": "One review cycle: the window, the scope, the configured sources, the caller's collection report and, for compile, the caller's annotations. The skill checks these rules in code; the schema documents them. Counts that span several lists (2000 items in all) are checked in code only.",
  "type": "object",
  "required": ["action", "cycle_start", "cycle_end", "risk_domains", "jurisdictions", "sources", "max_items", "collection"],
  "additionalProperties": false,
  "properties": {
    "action": {"enum": ["screen", "compile"]},
    "cycle_start": {"$ref": "#/$defs/date"},
    "cycle_end": {"$ref": "#/$defs/date"},
    "risk_domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/jurisdiction"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/source"}
    },
    "max_items": {"type": "integer", "minimum": 1, "maximum": 200},
    "client_exposure_tags": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "previous_tallies": {
      "type": "object",
      "required": ["by_domain"],
      "additionalProperties": false,
      "properties": {
        "by_domain": {
          "description": "Previous counts of scope domains; a missing count is 0.",
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100000}
        }
      }
    },
    "collection": {
      "description": "Exactly one report per configured source.",
      "type": "array",
      "items": {"$ref": "#/$defs/report"}
    },
    "log_destination": {"$ref": "#/$defs/text", "maxLength": 512},
    "attestation": {
      "type": "object",
      "required": ["attested", "minutes"],
      "additionalProperties": false,
      "properties": {
        "attested": {"type": "boolean"},
        "minutes": {"type": "integer", "minimum": 0, "maximum": 1440}
      }
    },
    "annotations": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/annotation"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "screen"}}},
      "then": {"not": {"anyOf": [{"required": ["attestation"]}, {"required": ["annotations"]}]}}
    },
    {
      "if": {"properties": {"action": {"const": "compile"}}},
      "then": {"required": ["annotations"]}
    }
  ],
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "jurisdiction": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,7}$"},
    "link": {
      "description": "Data only; the skill never opens it.",
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://[A-Za-z0-9./_-]*$"
    },
    "text": {
      "description": "Not blank, and no control character.",
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": ["name", "url", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "url": {"$ref": "#/$defs/link"},
        "kind": {"enum": ["literature", "regulatory", "technology", "economic"]}
      }
    },
    "report": {
      "type": "object",
      "required": ["source_name", "status", "items"],
      "additionalProperties": false,
      "properties": {
        "source_name": {"$ref": "#/$defs/text"},
        "status": {"enum": ["ok", "unreachable"]},
        "items": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "item": {
      "type": "object",
      "required": ["title", "published_date", "jurisdiction", "domains"],
      "additionalProperties": false,
      "properties": {
        "title": {"$ref": "#/$defs/text", "maxLength": 300},
        "published_date": {"$ref": "#/$defs/date"},
        "jurisdiction": {"$ref": "#/$defs/jurisdiction"},
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/code"}
        },
        "exposure_tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/code"}
        },
        "url": {"$ref": "#/$defs/link"}
      }
    },
    "annotation": {
      "type": "object",
      "required": ["item_ref", "summary", "impact"],
      "additionalProperties": false,
      "properties": {
        "item_ref": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text", "maxLength": 2000},
        "impact": {
          "type": "object",
          "required": ["area", "likelihood", "note"],
          "additionalProperties": false,
          "properties": {
            "area": {"enum": ["exposures", "methods", "both", "none"]},
            "likelihood": {"enum": ["low", "medium", "high"]},
            "note": {"$ref": "#/$defs/text", "maxLength": 1000}
          }
        }
      }
    }
  }
}
