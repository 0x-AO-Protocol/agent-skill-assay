{
  "schema_version": 1,
  "platform": "override_demo",
  "profile_version": "2026-10-01",
  "verified_on": "2026-10-01",
  "sources": [
    {
      "title": "Synthetic override profile",
      "reference": "Written for the fixtures of this bundle; it describes no real platform",
      "retrieved_on": "2026-10-01"
    }
  ],
  "search": {
    "per_query_result_cap": 500,
    "max_query_length": 250,
    "grammar": {
      "and": "AND",
      "or": "OR",
      "not": "NOT",
      "quote": "\"",
      "group_open": "(",
      "group_close": ")",
      "forbidden_characters": [
        "\"",
        "(",
        ")",
        "\u201c",
        "\u201d"
      ],
      "reserved_words": [
        "AND",
        "OR",
        "NOT"
      ]
    },
    "url": {
      "base": "https://people.override.example/search/",
      "keywords_param": "q",
      "fixed_params": [
        {
          "name": "mode",
          "value": "people"
        }
      ],
      "filter_value_encoding": "json_string_array",
      "max_length": 1500
    }
  },
  "filters": {
    "geo": {
      "filter_id": "region",
      "values": null
    },
    "company_size": {
      "filter_id": "size",
      "values": [
        "1-50",
        "51-500",
        "501+"
      ]
    },
    "seniority": {
      "filter_id": "level",
      "values": [
        "entry",
        "senior",
        "manager",
        "director",
        "vp",
        "cxo",
        "owner"
      ]
    },
    "industry": {
      "filter_id": "industry",
      "values": null
    },
    "language": {
      "filter_id": "lang",
      "values": null
    }
  },
  "partition_order": [
    "geo",
    "seniority",
    "company_size"
  ],
  "pacing": {
    "per_run_max_queries": 3,
    "per_day_max_rows": 400
  },
  "export_columns": {
    "profile_url": "url",
    "title": "headline",
    "source_query": "source",
    "company": "org",
    "location": "place"
  },
  "profile_key": {
    "host_suffixes": [
      "override.example"
    ],
    "path_prefix": "/people/"
  }
}
