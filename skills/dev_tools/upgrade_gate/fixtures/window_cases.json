    {
      "name": "breaking_hits_and_path_hits_ordering",
      "params": {
        "action": "digest",
        "as_of": "2026-09-12",
        "since": "2026-09-05",
        "watched": [
          {
            "repo": "demo/kit",
            "events": [
              {
                "type": "commit",
                "id": "c2",
                "at": "2026-09-09T08:00:00Z",
                "title": "Dropped and REMOVED and dropped",
                "paths": [
                  "src/b.py",
                  "docs/x.md"
                ]
              },
              {
                "type": "commit",
                "id": "c1",
                "at": "2026-09-09T08:00:00Z",
                "title": "incompatible change",
                "paths": [
                  "src/a.py"
                ]
              },
              {
                "type": "release",
                "id": "r1",
                "at": "2026-09-10T08:00:00Z",
                "title": "Breaking: v2",
                "paths": [
                  "src/z.py"
                ]
              },
              {
                "type": "commit",
                "id": "c3",
                "at": "2026-09-11T08:00:00Z",
                "paths": [
                  "lib/a.py",
                  "src/c.py"
                ]
              }
            ]
          }
        ],
        "policy": {
          "paths_of_interest": [
            "src/*.py",
            "docs/**",
            "src/*.py",
            "lib/*"
          ]
        }
      },
      "expected": {
        "status": "completed",
        "window": {
          "since": "2026-09-05",
          "as_of": "2026-09-12"
        },
        "per_repo": [
          {
            "repo": "demo/kit",
            "counts": {
              "release": 1,
              "tag": 0,
              "commit": 3
            },
            "version_jumps": [],
            "breaking_hits": [
              {
                "event_id": "c1",
                "term": "INCOMPATIBLE"
              },
              {
                "event_id": "c2",
                "term": "REMOVED"
              },
              {
                "event_id": "c2",
                "term": "DROPPED"
              },
              {
                "event_id": "r1",
                "term": "BREAKING"
              }
            ],
            "path_hits": [
              {
                "event_id": "c1",
                "pattern": "src/*.py"
              },
              {
                "event_id": "c2",
                "pattern": "src/*.py"
              },
              {
                "event_id": "c2",
                "pattern": "docs/**"
              },
              {
                "event_id": "c3",
                "pattern": "src/*.py"
              },
              {
                "event_id": "c3",
                "pattern": "lib/*"
              }
            ],
            "notable": [
              "c1",
              "c2",
              "r1",
              "c3"
            ],
            "dropped_before_since": 0,
            "unparsed_versions": 1
          }
        ],
        "fired_any": true,
        "insufficient": true
      }
