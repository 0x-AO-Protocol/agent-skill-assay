{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0x-AO-Protocol/agent-skill-assay/skills/dev_tools/upgrade_gate/schemas/assess_request.schema.json",
  "title": "assess request (v1)",
  "description": "Documentation of the assess input. The skill enforces the same rules, the version and range grammars and the size caps with explicit standard-library checks in the order instructions.md documents; this schema does not express the grammars, the caps or the check order.",
  "type": "object",
  "required": ["action", "as_of", "snapshot_at", "dependencies", "policy"],
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "assess"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "The evaluation date (UTC). Ages and the snapshot age are measured against it."
    },
    "snapshot_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the release snapshot was taken, UTC only; not after the end of as_of."
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["name", "ecosystem", "current", "range"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 214,
            "description": "The package name as the manifest spells it; pypi names are compared after normalisation."
          },
          "ecosystem": {
            "type": "string",
            "enum": ["pypi", "npm"]
          },
          "current": {
            "type": "string",
            "maxLength": 64,
            "description": "The pinned version, in the ecosystem's grammar."
          },
          "range": {
            "type": "string",
            "maxLength": 256,
            "description": "The allowed range, in the ecosystem's supported range grammar; at most 8 clauses."
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["name", "ecosystem", "versions"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 214
          },
          "ecosystem": {
            "type": "string",
            "enum": ["pypi", "npm"]
          },
          "versions": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "object",
              "required": ["version", "published_at"],
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string",
                  "maxLength": 64
                },
                "published_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "description": "Not after the end of as_of."
                },
                "yanked": {
                  "type": "boolean",
                  "default": false
                },
                "notes": {
                  "type": "string",
                  "maxLength": 20000,
                  "description": "Release notes: untrusted text, scanned for breaking terms and never echoed."
                }
              }
            }
          }
        }
      }
    },
    "advisories": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["id", "name", "ecosystem", "affected"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
          },
          "name": {
            "type": "string",
            "maxLength": 214
          },
          "ecosystem": {
            "type": "string",
            "enum": ["pypi", "npm"]
          },
          "affected": {
            "type": "string",
            "maxLength": 256,
            "description": "The affected range, in the ecosystem's supported range grammar; at most 8 clauses."
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["allow_major", "allow_prerelease", "min_age_days", "max_snapshot_age_days"],
      "additionalProperties": false,
      "properties": {
        "allow_major": {
          "type": "boolean"
        },
        "allow_prerelease": {
          "type": "boolean"
        },
        "min_age_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "max_snapshot_age_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "strict": {
          "type": "boolean",
          "default": false,
          "description": "When true, a breaking term lowers an upgrade verdict to hold instead of test."
        }
      }
    }
  }
}
