{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "version",
    "issuer",
    "trust_tier",
    "provenance",
    "norm_version"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "issuer": {
      "type": "object",
      "required": ["org", "name", "github"],
      "properties": {
        "org": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "github": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "trust_tier": {"enum": ["L0", "L2", "L3", "L4"]},
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source", "content_sha256", "ported_on"],
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^agent-skill-assay-sources@[0-9a-f]{7,64}:.+"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "ported_on": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["anchor", "content_sha256", "authored_on"],
          "properties": {
            "anchor": {"const": "repository"},
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "authored_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "format": "date"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "economic_effect": {
      "type": ["object", "null"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "baseline_task": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}
      },
      "required": ["claim", "baseline_task", "metric", "method"],
      "additionalProperties": false
    },
    "norm_version": {"type": "string", "minLength": 1},
    "origin": {"enum": ["ao_standard", "ao_defined", "third_party"]},
    "serves_dwa": {
      "type": "object",
      "required": ["onet_release", "ids"],
      "properties": {
        "onet_release": {"const": "31.0"},
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^4\\.A\\.[1-4]\\.[a-d]\\.[0-9]+\\.[a-z]{1,2}\\.[0-9]+$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"required": ["origin"], "properties": {"origin": {"const": "third_party"}}},
      "then": {"properties": {"issuer": {"properties": {"org": {"not": {"const": "AO"}}}}}},
      "else": {"properties": {"issuer": {"properties": {"org": {"const": "AO"}}}}}
    },
    {
      "if": {"required": ["origin"], "properties": {"origin": {"const": "ao_standard"}}},
      "then": {"required": ["serves_dwa"]}
    }
  ],
  "additionalProperties": true
}
